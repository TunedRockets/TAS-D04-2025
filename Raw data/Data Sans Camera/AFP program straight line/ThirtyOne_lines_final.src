DEF ThirtyOne_lines_final()
;FOLD Variable Declaration
REAL APPROACHSPEED
REAL PRECUTSPEED
REAL ROTATIONSPEED
REAL TRAVELSPEED
REAL POSTCUTSPEED
REAL RUNWAYSPEED
REAL REDUCEDSPEED
REAL HOMINGSPEED
REAL CUTTERPULSETIME
REAL HEATERONDELAY
REAL HEATEROFFDELAY
REAL PATHVALUE
FRAME COMPSTROKE
;ENDFOLD (Variable Declaration)

;FOLD Initialization
BAS(#INITMOV,0)
BAS(#TOOL,9)
BAS(#BASE,9)
$ORI_TYPE = #VAR
$CIRC_TYPE = #BASE
$VEL_EXTAX[1] = 30.000; %
$VEL_EXTAX[2] = 30.000; %
$ACC_EXTAX[1] = 100.000; %
$ACC_EXTAX[2] = 100.000; %
CORRECTSUBMIT = FALSE
$ADVANCE = 3

AFPXS_STATE = 0
PINCH = TRUE
COMPACTION = FALSE
CUTTER = FALSE
HEATER = FALSE
FEED_SYNC = FALSE
COMPSTROKE = $NULLFRAME
COMPSTROKE.Z = 4.000; mm of compaction
$TOOL = TOOL_DATA[9]:COMPSTROKE
PTP $AXIS_ACT; skip BCO quickly
;ENDFOLD (Initialization)
;FOLD ----- Laminate 2, Total Layers: 1 -----
LAYUPNUM = 2
LAYERNUM = 0
ORIENTATION = 0
PASSNUM = 0
;FOLD Laminate Parameters
HOMINGSPEED = 20.000; Speed in % for PTP motion to home position
PATHVALUE = 2; mm
TAPEFEEDLENGTH = 60.000 + PATHVALUE; mm
TAPE_THICKNESS = 0.100; mm
CUTTERPULSETIME = 0.5 ;sec
HEATERONDELAY = 0; milliseconds
HEATEROFFDELAY = 0; milliseconds
; ENDFOLD (Speed Parameters)
HALT ; Waiting for user input
;FOLD ----- Layer 1: 0.000 deg -----
;FOLD Layer Speed Settings
PRECUTSPEED = 0.100 ;m/s
POSTCUTSPEED = 0.100; m/s
APPROACHSPEED = 0.050; m/s
TRAVELSPEED = 0.200; m/s
RUNWAYSPEED = 0.050; m/s
REDUCEDSPEED = 0.200; reduced layup speed
HOMINGSPEED = 20.000; Speed in % for PTP motion to home position
ROTATIONSPEED = 50.000; degree/s
TAPE_FEED_SPEED = 50.000; mm/s
BAS(#ACC_CP, 100); %
;ENDFOLD
$APO.CDIS = 10;
BAS(#VEL_CP, TRAVELSPEED) 
;FOLD ----- Pass 1 -----
LAYUPNUM = 2
LAYERNUM = 1
ORIENTATION = 0
PASSNUM = 1
;GO TO APPROACH START
TRIGGER WHEN DISTANCE = 0 DELAY = 0 DO AFPXS_STATE = 2
LIN {X -78.681, Y 125, Z 24.543, A 0.000, B 0.000, C 0.000, E1 -3200.000, E2 0.000} C_DIS; Approach
HALT
LIN {X -78.681, Y 125, Z 24.543, A 0.000, B 0.000, C 0.000, E1 -3200.000, E2 0.000} C_DIS; Approach
;BEFORE APPROACH
WAIT FOR AFPXS_STATE <> 2; Waiting for the initial feed to complete
MAX_HEATER_INTENSITY = 80
;DOING APPROACH
BAS(#VEL_CP, APPROACHSPEED)
TRIGGER WHEN DISTANCE = 1 DELAY = 0 DO AFPXS_STATE = 1
TRIGGER WHEN DISTANCE = 1 DELAY = 0 DO COMPACTION = TRUE
TRIGGER WHEN DISTANCE = 0 DELAY = HEATERONDELAY DO HEATER = TRUE
LIN {X -9.989, Y 125, Z 0, A 0.000, B 0.000, C 0.000, E1 -3200.000, E2 0.000} C_DIS; RunwayStart
BAS(#VEL_CP, RUNWAYSPEED) ;Going slow while feed in sync
MAX_HEATER_INTENSITY = 80
TRIGGER WHEN PATH = PATHVALUE ONSTART DELAY = 0 DO FEED_SYNC = TRUE
TRIGGER WHEN DISTANCE = 1 DELAY = 0 DO PINCH = FALSE
TRIGGER WHEN DISTANCE = 1 DELAY = 0 DO FEED_SYNC = FALSE
LIN {X 0.011, Y 125, Z 0, A 0.000, B 0.000, C 0.000, E1 -3200.000, E2 0.000} C_DIS; LayupStart
BAS(#VEL_CP, REDUCEDSPEED)
MAX_HEATER_INTENSITY = 80
LIN {X 930.011, Y 125, Z 0, A 0.000, B 0.000, C 0.000, E1 -3200.000, E2 0.000}; Cutting
AFPXS_PulseCutter(CUTTERPULSETIME)
MAX_HEATER_INTENSITY = 80
BAS(#VEL_CP, REDUCEDSPEED)
LIN {X 930.011, Y 125, Z 0, A 0.000, B 0.000, C 0.000, E1 -3200.000, E2 0.000} C_DIS; Layup
TRIGGER WHEN DISTANCE = 1 DELAY = 0 DO AFPXS_STATE = 0
LIN {X 1000.011, Y 125, Z 0, A 0.000, B 0.000, C 0.000, E1 -3200.000, E2 0.000} C_DIS; LayupEnd
MAX_HEATER_INTENSITY = 80
LIN {X 1110.011, Y 125, Z 0, A 0.000, B 0.000, C 0.000, E1 -3200.000, E2 0.000} C_DIS; OverTravel
TRIGGER WHEN DISTANCE = 1 DELAY = 0 DO COMPACTION = FALSE
LIN {X 1120.011, Y 125, Z 0, A 0.000, B 0.000, C 0.000, E1 -3200.000, E2 0.000} C_DIS; OverTravelEnd
BAS(#VEL_CP, APPROACHSPEED)
TRIGGER WHEN DISTANCE = 0 DELAY = HEATEROFFDELAY DO HEATER = FALSE
LIN {X 1188.692, Y 125, Z 24.808, A 0.000, B 0.000, C 0.000, E1 -3200.000, E2 0.000} C_DIS; Retract
BAS(#VEL_CP, TRAVELSPEED)
